% git, разработка

# Показать состояние изменений Git
git status --short --branch

# Посмотреть изменения перед сохранением
git diff

# Посмотреть подготовленные изменения
git diff --cached

# Показать последние сохранения и ветки
git log --oneline --graph --decorate -20

# Показать локальные и удалённые ветки
git branch --all

# Получить изменения с сервера Git
git fetch

# Сохранить подготовленные изменения с описанием
git commit -m "<message>"
