% ssh, sftp, серверы

# Подключиться к серверу по SSH
ssh "<host>"

# Подключиться к серверу по SFTP
sftp "<host>"

# Проверить итоговые настройки SSH без подключения
ssh -G "<host>"

# Показать загруженные в агент SSH ключи
ssh-add -l

# Добавить основной ключ SSH в агент
ssh-add "$HOME/.ssh/id_ed25519"

# Скопировать файл на сервер
scp "<path>" "<host>:<destination>"
