% файлы, поиск, архивы

# Показать файлы папки, включая скрытые
ls -lah -- "<path>"

# Показать размер папки или файла
du -sh -- "<path>"

# Найти текст в файлах папки
rg -n -- "<text>" "<path>"

# Найти файлы по имени
find "<path>" -type f -name "<pattern>"

# Посмотреть содержимое архива tar
tar -tf "<archive>"

# Посмотреть практические примеры команды
tldr "<command>"

% df, диски, свободное место

# Показать свободное место и типы файловых систем на дисках
df -hT

# Показать свободное место для выбранной папки
df -h -- "<path>"

# Показать использование и свободное количество файловых узлов
df -ih
