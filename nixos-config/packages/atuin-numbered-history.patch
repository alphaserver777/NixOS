+    #[test]
+    fn numbered_three_digit_selection_is_absolute() {
+        use ratatui::crossterm::event::KeyCode;
+        let mut state = numbered_test_state();
+        for digit in "123".chars() {
+            assert!(matches!(numbered_key(&mut state, KeyCode::Char(digit)), super::InputAction::Continue));
+        }
+        assert_eq!(state.results_state.selected(), 122);
+        assert!(matches!(numbered_key(&mut state, KeyCode::Enter), super::InputAction::Accept(122)));
+        assert!(state.accept);
+    }
+
+    #[test]
+    fn numbered_invalid_input_never_accepts_another_row() {
+        use ratatui::crossterm::event::KeyCode;
+        for number in ["0", "201", "999999999999999999999999999999999"] {
+            let mut state = numbered_test_state();
+            for digit in number.chars() { numbered_key(&mut state, KeyCode::Char(digit)); }
+            assert!(matches!(numbered_key(&mut state, KeyCode::Enter), super::InputAction::Continue));
+            assert!(matches!(numbered_key(&mut state, KeyCode::Tab), super::InputAction::Continue));
+            assert!(!state.accept);
+        }
+    }
+
+    #[test]
+    fn numbered_backspace_edit_and_escape() {
+        use ratatui::crossterm::event::KeyCode;
+        let mut state = numbered_test_state();
+        for digit in "123".chars() { numbered_key(&mut state, KeyCode::Char(digit)); }
+        numbered_key(&mut state, KeyCode::Backspace);
+        assert!(matches!(numbered_key(&mut state, KeyCode::Tab), super::InputAction::Accept(11)));
+        assert!(!state.accept);
+        numbered_key(&mut state, KeyCode::Esc);
+        assert!(state.number_input.is_empty());
+    }
+
+    #[test]
