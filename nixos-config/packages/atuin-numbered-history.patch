+        use ratatui::crossterm::event::KeyCode;
+        let mut state = numbered_test_state();
+        state.keymap_mode = KeymapMode::VimInsert;
+        for digit in "123".chars() { numbered_key(&mut state, KeyCode::Char(digit)); }
+        assert_eq!(state.search.input.as_str(), "123");
