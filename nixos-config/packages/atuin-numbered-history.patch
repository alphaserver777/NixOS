+    fn numbered_key(state: &mut State, code: ratatui::crossterm::event::KeyCode) -> super::InputAction {
+        use ratatui::crossterm::event::{KeyEvent, KeyModifiers};
+        let mut settings = Settings::utc();
+        settings.enter_accept = true;
+        state.handle_key_input(&settings, &KeyEvent::new(code, KeyModifiers::NONE))
