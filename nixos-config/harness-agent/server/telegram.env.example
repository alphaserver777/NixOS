# Секретный файл на сервере: /etc/professorit-agent/telegram.env
# Права: root:root, 0600. Не добавлять настоящий токен в Git.

TELEGRAM_BOT_TOKEN=ВСТАВЬТЕ_ТОКЕН_ОТ_BOTFATHER
TG_ADMIN_CHAT_IDS=698226393
DSH_PROJECTS_DIR=/root/professor_ot/agent/projects
DSH_SESSIONS_DIR=/root/.dsh/sessions
DSH_TG_CLI_BIN=/usr/local/bin/dsh
DSH_TG_PROFILE=headless
DSH_TG_TIMEOUT_MIN=30
DSH_TG_POLL_TIMEOUT_S=10
